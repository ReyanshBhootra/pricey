# Copy to .env.local. Leave blank to run on in-memory seed data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Gemini (chat + receipt scanning). Server only, never prefix with NEXT_PUBLIC_.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Tried first if set. Otherwise chat uses gemini-flash-lite-latest (fast) and
# receipts use gemini-flash-latest, each falling back to the other when busy.
GEMINI_MODEL=

# Person D, iMessage via Photon. Any long random string; the same value goes in bot/.env.
TEXT_BOT_SECRET=
